<?xml version="1.0"?>
<robot name="panda" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 车架与车轮的引入 -->
  <xacro:include filename="$(find robot_description)/urdf/inertial_macros.xacro" />
  <xacro:include filename="$(find robot_description)/urdf/base.urdf.xacro" />
  <xacro:include filename="$(find robot_description)/urdf/diff_wheels.urdf.xacro" />
  
  <!-- 实例化车架 -->
  <xacro:base parent="base_footprint">
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </xacro:base>

  <!-- 实例化车轮 -->
  <xacro:diff_wheels />

  <!-- 激光雷达的引入 -->
  <xacro:include filename="$(find robot_description)/urdf/lidar.urdf.xacro" />

  <!-- 安装激光雷达 -->
  <xacro:lidar parent="base_link">
    <origin xyz="-0.04 0.04 0.06" rpy="0 0 0" />
  </xacro:lidar>

  <!-- 机器人手部相机引入 -->
  <xacro:include filename="$(find robot_description)/urdf/_d455.urdf.xacro" />

  <!-- 实例化相机 -->
  <xacro:sensor_d455 parent="panda_hand" name="hand_camera" use_nominal_extrinsics="true" use_mesh="true" near="0.05" far="2.0">
    <origin xyz="-0.05 0 0.03" rpy="0 -1.57 0"/>
  </xacro:sensor_d455>

  <!-- Panda 机械臂引入 -->
  <xacro:include filename="$(find robot_description)/urdf/arm.xacro" />

  <xacro:include filename="$(find robot_description)/urdf/gazebo.xacro" />
  <xacro:include filename="$(find robot_description)/urdf/ros2_control.xacro" />
    
</robot>