<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Differential drive: 2 driven wheels + 2 casters
       All 4 placed at the same corner positions as the original omni wheels -->
  <xacro:macro name="diff_wheels">

    <!-- Left drive wheel — at the left-centre position (y=+0.086338) -->
    <joint name="left_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="left_wheel_link"/>
      <origin xyz="0.0 0.259 -0.066" rpy="-1.5707963 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <link name="left_wheel_link">
      <visual>
        <geometry><cylinder radius="0.084" length="0.075"/></geometry>
        <material name="wheel_dark"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="0.084" length="0.075"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="2.7"/>
        <inertia ixx="0.0059" ixy="0" ixz="0" iyy="0.0059" iyz="0" izz="0.0095"/>
      </inertial>
    </link>

    <!-- Right drive wheel — at the right-centre position (y=-0.086338) -->
    <joint name="right_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="right_wheel_link"/>
      <origin xyz="0.0 -0.259 -0.066" rpy="-1.5707963 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <link name="right_wheel_link">
      <visual>
        <geometry><cylinder radius="0.084" length="0.075"/></geometry>
        <material name="wheel_dark"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="0.084" length="0.075"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="2.7"/>
        <inertia ixx="0.0059" ixy="0" ixz="0" iyy="0.0059" iyz="0" izz="0.0095"/>
      </inertial>
    </link>

    <!-- Front caster — at the front-centre position (x=+0.086338) -->
    <joint name="front_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="front_caster_link"/>
      <origin xyz="0.259 0.0 -0.090" rpy="0 0 0"/>
    </joint>
    <link name="front_caster_link">
      <visual>
        <geometry><sphere radius="0.060"/></geometry>
        <material name="caster_grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
      </visual>
      <collision>
        <geometry><sphere radius="0.060"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.35"/>
        <inertia ixx="0.0019" ixy="0" ixz="0"
                 iyy="0.0019" iyz="0"
                 izz="0.0019"/>
      </inertial>
    </link>

    <!-- Rear caster — at the rear-centre position (x=-0.086338) -->
    <joint name="rear_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="rear_caster_link"/>
      <origin xyz="-0.259 0.0 -0.090" rpy="0 0 0"/>
    </joint>
    <link name="rear_caster_link">
      <visual>
        <geometry><sphere radius="0.060"/></geometry>
        <material name="caster_grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
      </visual>
      <collision>
        <geometry><sphere radius="0.060"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.35"/>
        <inertia ixx="0.0019" ixy="0" ixz="0"
                 iyy="0.0019" iyz="0"
                 izz="0.0019"/>
      </inertial>
    </link>

    <!-- Gazebo friction properties -->
    <gazebo reference="left_wheel_link">
      <material>Gazebo/DarkGrey</material>
      <mu1>1.0</mu1><mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="right_wheel_link">
      <material>Gazebo/DarkGrey</material>
      <mu1>1.0</mu1><mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="front_caster_link">
      <material>Gazebo/Grey</material>
      <mu1>0.001</mu1><mu2>0.001</mu2>
    </gazebo>
    <gazebo reference="rear_caster_link">
      <material>Gazebo/Grey</material>
      <mu1>0.001</mu1><mu2>0.001</mu2>
    </gazebo>

    <!-- Differential drive plugin for Ignition Gazebo -->
    <gazebo>
      <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
        <!-- 左右轮关节 -->
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        
        <!-- 几何参数 -->
        <wheel_separation>0.518</wheel_separation>
        <wheel_radius>0.084</wheel_radius>
        
        <!-- 动力学与加速度限制 -->
        <max_linear_acceleration>5.0</max_linear_acceleration>
        <max_angular_acceleration>10.0</max_angular_acceleration>
        <min_linear_acceleration>-5.0</min_linear_acceleration>
        <min_angular_acceleration>-10.0</min_angular_acceleration>
        <max_linear_velocity>2.0</max_linear_velocity>
        <min_linear_velocity>-2.0</min_linear_velocity>
        <max_angular_velocity>3.0</max_angular_velocity>
        <min_angular_velocity>-3.0</min_angular_velocity>

        <!-- 坐标系与话题发布开关 -->
        <odom_publish_frequency>50</odom_publish_frequency>
        <topic>/cmd_vel</topic>
        <odom_topic>odom</odom_topic>
        <tf_topic>tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <publish_wheel_tf>false</publish_wheel_tf>
      </plugin>

      <plugin filename="libignition-gazebo-joint-state-publisher-system.so" 
              name="ignition::gazebo::systems::JointStatePublisher">
        <update_frequency>50</update_frequency>
      </plugin>

    </gazebo>

  </xacro:macro>

</robot>
